{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "38;2;196;167;231"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;156;207;216",
            "output": "38;2;144;140;170"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "key": " ",
            "keyColor": "38;2;196;167;231"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;2;156;207;216"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "38;2;156;207;216"
        },
        {
            "type": "uptime",
            "key": "󰥔 ",
            "keyColor": "38;2;235;188;186"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "38;2;246;193;119"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "38;2;246;193;119"
        },
        {
            "type": "cpu",
            "key": "󰍛 ",
            "keyColor": "38;2;49;116;143"
        },
        {
            "type": "memory",
            "key": "󰑭 ",
            "keyColor": "38;2;49;116;143"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
