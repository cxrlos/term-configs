# Shared git settings (linked as ~/.config/git/config). Identity and signing key are
# machine-local in ~/.config/git/config.local: personal by default; on the Mac it also has
# [includeIf "hasconfig:remote.*.url:git@github.com:<work-org>/**"] path = config.work
# (work email + key), so identity follows the repo's remote, never its directory.
[init]
    defaultBranch = main
[core]
    editor = nvim
    pager = delta
    hooksPath = ~/.config/git/hooks   # gitleaks pre-commit, signed-only pre-push; repo hooks still run (git/hooks/chain)
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true       # one diff: git -c delta.side-by-side=false diff
    dark = true               # don't query the terminal (stalls in tmux/ssh); we're always dark
    hyperlinks = true         # Ctrl+click commit hashes (GitHub) and file paths
    syntax-theme = ansi       # code colours from the terminal palette = Tokyo Night
    # Tokyo Night (folke/tokyonight.nvim extras/delta)
    minus-style = syntax "#4a272f"
    minus-non-emph-style = syntax "#4a272f"
    minus-emph-style = syntax "#713137"
    minus-empty-line-marker-style = syntax "#4a272f"
    line-numbers-minus-style = "#914c54"
    plus-style = syntax "#243e4a"
    plus-non-emph-style = syntax "#243e4a"
    plus-emph-style = syntax "#2c5a66"
    plus-empty-line-marker-style = syntax "#243e4a"
    line-numbers-plus-style = "#449dab"
    line-numbers-zero-style = "#3b4261"
[commit]
    gpgSign = true
    verbose = true
[tag]
    gpgSign = true
    sort = version:refname
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
[push]
    default = current
    autoSetupRemote = true
    followTags = true
    useForceIfIncludes = true   # --force-with-lease also refuses if you never pulled what you'd overwrite
[pull]
    rebase = true
[fetch]
    prune = true
    pruneTags = true
    all = true
[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
    colorMoved = default
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[column]
    ui = auto
[help]
    autocorrect = prompt
# Last: later values win, so config.local (and its config.work) can override anything above,
# e.g. gpg.format = openpgp for a work GPG key.
[include]
    path = config.local
