#!/usr/bin/env bash

SCRIPT_PATH="${BASH_SOURCE[0]}"
[[ -L "$SCRIPT_PATH" ]] && SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
YAML="$REPO_DIR/sessionizer/projects.yaml"

RESURRECT_DIR="${TMUX_RESURRECT_DIR:-}"
if [[ -z "$RESURRECT_DIR" ]]; then
    if [[ -d "$HOME/.tmux/resurrect" ]]; then
        RESURRECT_DIR="$HOME/.tmux/resurrect"
    else
        RESURRECT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    fi
fi
RESTORE_SCRIPT="${TMUX_RESURRECT_RESTORE:-$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh}"

MACHINE_NAME=$(hostname -s)

# ── YAML readers ─────────────────────────────────────────────────────────────

_read_projects() {
    [[ -f "$YAML" ]] || return

    local proj_count dir i
    proj_count=$(yq '.projects | length' "$YAML")
    for ((i=0; i<proj_count; i++)); do
        dir=$(yq -r ".projects[$i].locations[\"$MACHINE_NAME\"] // \"\"" "$YAML")
        dir="${dir/#\~/$HOME}"
        [[ -n "$dir" && -d "$dir" ]] && echo "$dir"
    done
}

# ── Hydration ────────────────────────────────────────────────────────────────

_default_layout() {
    local name="$1" dir="$2"
    tmux rename-window -t "$name:1" editor
    tmux send-keys -t "$name:editor" 'nvim .' Enter
    tmux new-window -t "$name" -n shell -c "$dir"
    tmux select-window -t "$name:editor"
}

_hydrate() {
    local name="$1" dir="$2"
    local script="$dir/.tmux-sessionizer"
    if [[ -x "$script" ]]; then
        TMUX_SESSION="$name" PROJECT_DIR="$dir" bash "$script"
    else
        _default_layout "$name" "$dir"
    fi
}

# ── Session helpers ──────────────────────────────────────────────────────────

_attach_or_switch() {
    local name="$1"
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$name"
    else
        tmux attach-session -t "$name"
    fi
}

_do_restore() {
    tmux start-server 2>/dev/null
    tmux new-session -ds _restore 2>/dev/null
    if [[ -x "$RESTORE_SCRIPT" ]]; then
        "$RESTORE_SCRIPT" 2>/dev/null
        local first
        first=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep -v '^_restore$' | head -1)
        if [[ -n "$first" ]]; then
            tmux kill-session -t _restore 2>/dev/null
            _attach_or_switch "$first"
            exit 0
        fi
    fi
    _attach_or_switch _restore
    exit 0
}

_open_session() {
    local selected="$1"
    [[ -d "$selected" ]] || exit 1
    local name
    name=$(basename "$selected" | tr '.' '_')

    if [[ -n "${TMUX:-}" ]]; then
        if ! tmux has-session -t="$name" 2>/dev/null; then
            tmux new-session -ds "$name" -c "$selected"
            _hydrate "$name" "$selected"
        fi
        tmux switch-client -t "$name"
    else
        if tmux has-session -t="$name" 2>/dev/null; then
            tmux attach-session -t "$name"
        else
            tmux new-session -ds "$name" -c "$selected"
            _hydrate "$name" "$selected"
            tmux attach-session -t "$name"
        fi
    fi
}

# ── Main ─────────────────────────────────────────────────────────────────────

if [[ $# -eq 1 ]]; then
    selected=$1
else
    restore=""
    [[ -f "$RESURRECT_DIR/last" ]] && restore="[restore] last saved"

    sessions=$(tmux list-sessions -F "[session] #{session_name}" 2>/dev/null)
    dirs=$(_read_projects | sed "s|$HOME|~|" | sort)

    selected=$(
        {
            echo "[new] add project"
            echo "$restore"
            echo "$sessions"
            echo "$dirs"
        } | grep -v '^$' |
            fzf --prompt="  " \
                --header="  switch or open project" \
                --color="fg:#908caa,hl:#c4a7e7,fg+:#e0def4,hl+:#eb6f92,info:#9ccfd8,pointer:#eb6f92,header:#9ccfd8,bg+:#26233a"
    ) || exit 0
fi

[[ -z "$selected" ]] && exit 0

if [[ "$selected" == "[new] add project" ]]; then
    printf '\n  cd into your project directory, then run:\n\n'
    printf '    %ssessionizer-add%s\n\n' $'\033[1m' $'\033[0m'
    exit 0
fi

if [[ "$selected" == "[restore] last saved" ]]; then
    _do_restore
fi

if [[ "$selected" == "[session] "* ]]; then
    _attach_or_switch "${selected#"[session] "}"
    exit 0
fi

selected="${selected/#\~/$HOME}"
_open_session "$selected"
