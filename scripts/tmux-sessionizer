#!/usr/bin/env bash

SCRIPT_PATH="${BASH_SOURCE[0]}"
[[ -L "$SCRIPT_PATH" ]] && SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
YAML="$REPO_DIR/sessionizer/projects.yaml"
INITIATIVE_BIN="$REPO_DIR/scripts/initiative"
GWT_BIN="$REPO_DIR/scripts/gwt"
FZF_COLORS="fg:#a6adc8,hl:#89dceb,fg+:#cdd6f4,hl+:#f38ba8,info:#89dceb,pointer:#f38ba8,header:#89dceb,bg+:#313244"
# shellcheck source=zsh/palette.sh
. "$REPO_DIR/zsh/palette.sh"

RESURRECT_DIR="${TMUX_RESURRECT_DIR:-}"
if [[ -z "$RESURRECT_DIR" ]]; then
    if [[ -d "$HOME/.tmux/resurrect" ]]; then
        RESURRECT_DIR="$HOME/.tmux/resurrect"
    else
        RESURRECT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
    fi
fi
RESTORE_SCRIPT="${TMUX_RESURRECT_RESTORE:-$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh}"

if [[ "$(uname)" == "Darwin" ]]; then
    MACHINE_NAME=$(hostname -s)
else
    MACHINE_NAME=$(uname -n)
fi

# ── YAML readers ─────────────────────────────────────────────────────────────

_read_projects() {
    [[ -f "$YAML" ]] || return

    local dir
    while IFS= read -r dir; do
        dir="${dir/#\~/$HOME}"
        [[ -n "$dir" && -d "$dir" ]] && echo "$dir"
    done < <(yq -r ".projects[].locations[\"$MACHINE_NAME\"] // \"\"" "$YAML")
}

# ── Hydration ────────────────────────────────────────────────────────────────

_default_layout() {
    local name="$1" dir="$2"
    tmux rename-window -t "$name:1" editor
    tmux send-keys -t "$name:editor" 'nvim .' Enter
    tmux new-window -t "$name" -n shell -c "$dir"
    tmux select-window -t "$name:editor"
}

_hydrate() {
    local name="$1" dir="$2"
    local script="$dir/.tmux-sessionizer"
    if [[ -x "$script" ]]; then
        TMUX_SESSION="$name" PROJECT_DIR="$dir" bash "$script"
    else
        _default_layout "$name" "$dir"
    fi
}

# ── Session helpers ──────────────────────────────────────────────────────────

_attach_or_switch() {
    local name="$1"
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$name"
    else
        tmux attach-session -t "$name"
    fi
}

_do_restore() {
    tmux start-server 2>/dev/null
    tmux new-session -ds _restore 2>/dev/null
    if [[ -x "$RESTORE_SCRIPT" ]]; then
        "$RESTORE_SCRIPT" 2>/dev/null
        local first
        first=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep -v '^_restore$' | head -1)
        if [[ -n "$first" ]]; then
            tmux kill-session -t _restore 2>/dev/null
            _attach_or_switch "$first"
            exit 0
        fi
    fi
    _attach_or_switch _restore
    exit 0
}

_open_session() {
    local selected="$1" name="${2:-}"
    [[ -d "$selected" ]] || exit 1
    [[ -z "$name" ]] && name=$(basename "$selected")
    name=$(printf '%s' "$name" | tr './' '__')

    if [[ -n "${TMUX:-}" ]]; then
        if ! tmux has-session -t="$name" 2>/dev/null; then
            tmux new-session -ds "$name" -c "$selected"
            _hydrate "$name" "$selected"
        fi
        tmux switch-client -t "$name"
    else
        if tmux has-session -t="$name" 2>/dev/null; then
            tmux attach-session -t "$name"
        else
            tmux new-session -ds "$name" -c "$selected"
            _hydrate "$name" "$selected"
            tmux attach-session -t "$name"
        fi
    fi
}

_hydrate_initiative() {
    local name="$1" ws="$2" resolved="$3"
    local kind repo path status adddirs="" first=""

    tmux rename-window -t "$name:1" notes
    tmux send-keys -t "$name:notes" 'nvim .' Enter

    while IFS=$'\t' read -r kind repo path status; do
        [[ "$kind" == "checkout" ]] || continue
        if [[ "$status" == "missing" ]]; then
            _warn "checkout '$repo' missing ($path) — skipping window"
            continue
        fi
        [[ "$status" == "fellback" ]] && _warn "worktree for '$repo' missing — opening main checkout"
        tmux new-window -t "$name" -n "$repo" -c "$path"
        tmux send-keys -t "$name:$repo" 'nvim .' Enter
        [[ -z "$first" ]] && first="$repo"
        adddirs="$adddirs --add-dir $path"
    done <<EOF
$resolved
EOF

    tmux new-window -t "$name" -n claude -c "$ws"
    tmux send-keys -t "$name:claude" "claude --ide$adddirs" Enter
    tmux new-window -t "$name" -n shell -c "$ws"

    if [[ -n "$first" ]]; then
        tmux select-window -t "$name:$first"
    else
        tmux select-window -t "$name:notes"
    fi
}

_open_initiative() {
    local id="$1" name resolved ws
    name=$(printf '%s' "$id" | tr './' '__')
    resolved=$("$INITIATIVE_BIN" resolve "$id") || { _err "cannot resolve initiative '$id'"; exit 1; }
    ws=$(printf '%s\n' "$resolved" | awk -F'\t' '$1=="workspace"{print $2; exit}')
    [[ -d "$ws" ]] || { _err "workspace missing: $ws"; exit 1; }

    if [[ -n "${TMUX:-}" ]]; then
        if ! tmux has-session -t="$name" 2>/dev/null; then
            tmux new-session -ds "$name" -c "$ws"
            _hydrate_initiative "$name" "$ws" "$resolved"
        fi
        tmux switch-client -t "$name"
    else
        if tmux has-session -t="$name" 2>/dev/null; then
            tmux attach-session -t "$name"
        else
            tmux new-session -ds "$name" -c "$ws"
            _hydrate_initiative "$name" "$ws" "$resolved"
            tmux attach-session -t "$name"
        fi
    fi
}

_pick_worktree() {
    local repo="$1" wts choice slug
    wts=$("$GWT_BIN" list --repo "$repo" 2>/dev/null)
    choice=$(
        {
            echo "[main] $(basename "$repo")"
            printf '%s\n' "$wts" | sed 's/^/[worktree] /'
            echo "[+ new worktree]"
        } | grep -v '^\[worktree\] $' | grep -v '^$' |
            fzf --prompt="  " --header="  worktree" --color="$FZF_COLORS"
    ) || return 1
    case "$choice" in
        "[main] "*)         printf '%s\n' "$repo" ;;
        "[+ new worktree]")
            printf '  new worktree slug: ' >&2
            read -r slug
            slug=$("$GWT_BIN" slug "$slug")
            [[ -z "$slug" ]] && return 1
            "$GWT_BIN" add "$slug" --repo "$repo"
            ;;
        "[worktree] "*)     printf '%s\n' "$repo/.worktrees/${choice#"[worktree] "}" ;;
        *) return 1 ;;
    esac
}

# ── Main ─────────────────────────────────────────────────────────────────────

if [[ "${1:-}" == "--initiatives" ]]; then
    selected=$(
        "$INITIATIVE_BIN" list 2>/dev/null | sed 's/^/[initiative] /' | grep -v '^$' |
            fzf --prompt="  " --header="  projects" --color="$FZF_COLORS"
    ) || exit 0
elif [[ $# -eq 1 ]]; then
    selected=$1
else
    restore=""
    [[ -f "$RESURRECT_DIR/last" ]] && restore="[restore] last saved"

    sessions=$(tmux list-sessions -F "[session] #{session_name}" 2>/dev/null)
    inits=$("$INITIATIVE_BIN" list 2>/dev/null | sed 's/^/[initiative] /')
    dirs=$(_read_projects | sed "s|$HOME|~|" | sort)

    selected=$(
        {
            echo "[new] add project"
            echo "$restore"
            echo "$sessions"
            echo "$inits"
            echo "$dirs"
        } | grep -v '^$' |
            fzf --prompt="  " \
                --header="  switch or open project" \
                --color="$FZF_COLORS"
    ) || exit 0
fi

[[ -z "$selected" ]] && exit 0

if [[ "$selected" == "[new] add project" ]]; then
    printf '\n  cd into your project directory, then run:\n\n'
    printf '    %ssessionizer-add%s\n\n' $'\033[1m' $'\033[0m'
    exit 0
fi

if [[ "$selected" == "[restore] last saved" ]]; then
    _do_restore
fi

if [[ "$selected" == "[session] "* ]]; then
    _attach_or_switch "${selected#"[session] "}"
    exit 0
fi

if [[ "$selected" == "[initiative] "* ]]; then
    _open_initiative "${selected#"[initiative] "}"
    exit 0
fi

selected="${selected/#\~/$HOME}"
if [[ -d "$selected/.worktrees" ]]; then
    target=$(_pick_worktree "$selected") || exit 0
    if [[ "$target" == "$selected" ]]; then
        _open_session "$target"
    else
        _open_session "$target" "$(basename "$selected")-$(basename "$target")"
    fi
else
    _open_session "$selected"
fi
