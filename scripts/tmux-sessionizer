#!/usr/bin/env bash
# Pick a git repo under $TS_ROOTS (colon-separated) level by level (org, then repo) and switch
# to its tmux session. Main checkouts get windows editor | shell. Linked worktrees (`wt new`)
# get editor | agent | shell: the agent window runs `agent-run` (scrubbed env, $AGENT).
# A repo's `.tmux-sessionizer` hook adds extras, but only once allowed (`--allow DIR`), like
# direnv: any edit to the hook needs a new allow. Sessions are named by path under the root
# (~/dev/nu/api -> nu/api). `*` marks open sessions. Enter opens, Esc goes up.
# Usage: tmux-sessionizer [-d] [dir] | --allow dir     (-d: create detached, print the name)
IFS=: read -r -a roots <<< "${TS_ROOTS:-$HOME/dev}"
allow_db=${XDG_STATE_HOME:-$HOME/.local/state}/tmux-sessionizer/allow
open=$(tmux list-sessions -F '#S' 2>/dev/null)

hash() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
rel() { local r; for r in "${roots[@]}"; do case $1 in "$r"/*) printf '%s' "${1#"$r"/}"; return ;; esac; done; basename "$1"; }
repos_under() { find "$1" -mindepth 2 -maxdepth 4 -name .git -prune 2>/dev/null | sed 's|/\.git$||'; }

if [ "$1" = --allow ]; then
    f=$(cd "$2" && pwd)/.tmux-sessionizer; [ -f "$f" ] || { echo "no hook in $2" >&2; exit 1; }
    mkdir -p "${allow_db%/*}"; echo "$(hash "$f") $f" >> "$allow_db"; echo "allowed $f"; exit 0
fi
detach=; [ "$1" = -d ] && { detach=1; shift; }

entries() { # one line per child of the given dirs: mark<TAB>label<TAB>kind<TAB>path
    local base c n r name m
    for base in "$@"; do for c in "$base"/*/; do
        c=${c%/}; [ -d "$c" ] || continue
        if [ -e "$c/.git" ]; then r=$c; n=1
        else r=$(repos_under "$c"); n=$(printf '%s' "$r" | grep -c .); fi
        [ "$n" -eq 0 ] && continue
        if [ "$n" -eq 1 ]; then
            name=$(rel "$r" | tr '.:' '__'); printf '%s' "$open" | grep -qxF "$name" && m='*' || m=' '
            printf '%s\t%s %s\t%s\t%s\n' "$m" "$m" "$(rel "$r")" repo "$r"
        else
            name=$(rel "$c" | tr '.:' '__'); printf '%s' "$open" | grep -q "^$name/" && m='*' || m=' '
            printf '%s\t%s %s/  (%s)\t%s\t%s\n' "$m" "$m" "$(rel "$c")" "$n" dir "$c"
        fi
    done; done | sort -t$'\t' -k1,1r -k2,2 | cut -f2-
}

pick() { # browse from the given dirs; prints the chosen repo path
    local line kind path
    while :; do
        line=$(entries "$@" | fzf --prompt="${prompt:-project}> " --delimiter='\t' --with-nth=1 \
            --header='enter: open · esc: up') || return 1
        kind=$(printf '%s' "$line" | cut -f2); path=$(printf '%s' "$line" | cut -f3)
        [ "$kind" = repo ] && { printf '%s' "$path"; return 0; }
        prompt=$(rel "$path") pick "$path" && return 0
    done
}

if [ $# -ge 1 ]; then dir=$(cd "$1" && pwd) || exit 1; else dir=$(pick "${roots[@]}") || exit 0; fi
name=$(rel "$dir" | tr '.:' '__')

if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$dir" -n editor
    tmux send-keys -t "=$name:editor" "${EDITOR:-nvim}" Enter
    if [ -f "$dir/.git" ]; then   # linked worktree: the only place agents run
        tmux new-window -d -t "=$name:" -n agent -c "$dir" "agent-run; exec \"\$SHELL\""
    fi
    tmux new-window -d -t "=$name:" -n shell -c "$dir"
    hook=$dir/.tmux-sessionizer
    if [ -x "$hook" ]; then
        if grep -qxF "$(hash "$hook") $hook" "$allow_db" 2>/dev/null; then
            (cd "$dir" && TS_SESSION=$name TS_DIR=$dir ./.tmux-sessionizer)
        else
            tmux display-message -t "=$name" "hook not allowed: tmux-sessionizer --allow $dir"
        fi
    fi
fi
[ -n "$detach" ] && { echo "$name"; exit 0; }
if [ -n "$TMUX" ]; then tmux switch-client -t "=$name"; else tmux attach -t "=$name"; fi
